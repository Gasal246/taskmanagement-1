# Copy to .env.local and configure credentials outside Git.
NEXTAUTH_SECRET=
NEXTAUTH_URL=
MONGO_URI=
NEXT_NODEMAILER_USER=
NEXT_NODEMAILER_PASS=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_BASE64=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Maximum MongoDB connections per Node process
MONGO_MAX_POOL_SIZE=30

# Use db:performance-indexes --apply before starting production.
MONGO_AUTO_INDEX=false

# Optional protected scheduler endpoint; use a randomly generated secret of at least 32 characters.
# A dedicated npm run worker:jobs process does not need this secret.
CRON_SECRET=
